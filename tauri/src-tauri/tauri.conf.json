{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HMSI",
  "version": "0.1.0",
  "identifier": "com.hmsi.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../../ run dev -w @hmsi/web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../../ run build -w @hmsi/web",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "نظام إدارة المستشفى — HMSI",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}