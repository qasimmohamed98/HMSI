{
  "name": "@hmsi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev.ts",
    "dev:local": "tsx watch src/dev.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:gen": "node scripts/gen-migrations.mjs",
    "db:migrate": "tsx --env-file=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env scripts/seed.ts",
    "test:smoke": "tsx scripts/smoke.ts",
    "db:seed:local": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@hmsi/shared": "0.1.0",
    "@hono/node-server": "^1.13.7",
    "@libsql/client": "^0.14.0",
    "@netlify/blobs": "^11.1.1",
    "@node-rs/argon2": "^2.0.2",
    "hono": "^4.6.14",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
