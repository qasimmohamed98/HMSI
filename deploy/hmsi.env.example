# /etc/hmsi/hmsi.env — صلاحيات 600، يملكه root (لا تضعه في git أبداً)
NODE_ENV=production
PORT=8787
HOST=127.0.0.1
# قاعدة البيانات: ملف SQLite محلي على قرص الخادم
LOCAL_DB_URL=file:/var/lib/hmsi/hmsi.db
# ⚠ انسخ نفس القيمة الموجودة الآن في Netlify — تغييرها يعطّل رموز التحقق بخطوتين
SESSION_SECRET=
# ⚠ نفس القيمة إن كانت مضبوطة في Netlify — بدونها لا تُفك النسخ الاحتياطية المشفّرة
BACKUP_KEY=
BACKUP_DIR=/var/lib/hmsi/backups
